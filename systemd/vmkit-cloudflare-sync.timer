[Unit]
Description=VminKit Cloudflare DNS sync (safety net)

[Timer]
# Asil tetikleyici .path birimi; zone dosyasi degistigi anda calisiyor.
# Bu zamanlayici yalnizca kacan bir olayi ya da basarisiz bir turu yakalamak
# icin. Zone degismediyse tur hicbir API cagrisi yapmadan bitiyor.
OnBootSec=3min
OnUnitActiveSec=15min
AccuracySec=1min
Unit=vmkit-cloudflare-sync.service

[Install]
WantedBy=timers.target
