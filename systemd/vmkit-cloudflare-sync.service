[Unit]
Description=VminKit - Cloudflare DNS senkronu
After=network-online.target bind9.service
Wants=network-online.target

[Service]
Type=oneshot
# Zone degismediyse script hicbir API cagrisi yapmadan cikar.
ExecStart=/usr/share/webmin/vmkit-cloudflare/sync-all.pl
# Bekleme YOK: DNS-01 dogrulamasinda challenge kaydinin Cloudflare'e saniyeler
# icinde ulasmasi gerekiyor. Art arda gelen zone yazimlari zaten sorun degil -
# zone degismediyse tur hicbir API cagrisi yapmadan bitiyor.
Nice=10
