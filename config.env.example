# vmin-kit - gözetimsiz çalıştırma için hazır cevaplar.
# Bu dosya VARSA install.sh soru sormaz; YOKSA sadece ana domaini sorar.
#   cp config.env.example config.env
#
# Not: Kurulum başarıyla bittiğinde araç zaten bir config.env üretir.
# İkinci sunucuda o dosyayı kopyalayıp MAIN_DOMAIN'i değiştirmeniz yeterli.

# ---- Zorunlu ----
MAIN_DOMAIN=ornek.com

# ---- Sunucu kimliği ----
HOST_PREFIX=s            # hostname = HOST_PREFIX.MAIN_DOMAIN  -> s.ornek.com
#HOSTNAME_FQDN=          # doldurulursa HOST_PREFIX yok sayılır
ADMIN_EMAIL=             # boş = admin@MAIN_DOMAIN

# ---- Kurulacaklar (1=yap, 0=atla) ----
POSTGRES=1               # PostgreSQL varsayılan kurulumda gelmiyor; 1 ise eklenir
COMPOSER=1               # Composer (vmkit-composer eklentisinin gereksinimi)
docker=1                 # Docker + Portainer + docker.<domain> proxy sitesi (tek bayrak)

# ---- Genel ----
SERVER_IP=               # boş = otomatik tespit
#DNS_RESOLVER=1.1.1.1    # DNS kontrolünde kullanılan dış resolver

# ---- Portainer ----
DOCKER_PREFIX=docker     # Portainer sitesi = DOCKER_PREFIX.MAIN_DOMAIN
PORTAINER_IMAGE=portainer/portainer-ce:latest
PORTAINER_PORT=9000
PORTAINER_BIND_LOCAL=yes # yes = sadece 127.0.0.1 (reverse-proxy ile erişin)

# ---- DNS (genelde gerekmez) ----
# Boşsa ns1.MAIN_DOMAIN / ns2.MAIN_DOMAIN kullanılır — DNS modundan bağımsız,
# çünkü zone her zaman "NS yönetimi bizde" modeline göre üretilir.
#NS1=
#NS2=

# ---- Kaçış kapıları ----
#SKIP_DNS_CHECK=1        # A kaydı kontrolünü atla (tavsiye edilmez)
#ALLOW_ANY_OS=1          # Debian 12 dışında da çalıştır
