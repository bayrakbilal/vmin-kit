# vmin-kit - varsayilan ayarlar.
#
# Bu dosya DEPODA durur ve tercihlerin yeridir: degistir, commit'le; sonraki
# sunucu depoyu cektiginde ayni sekilde kurulur. Hatirlamak zorunda kalma.
#
# ANA DOMAIN BURADA TUTULMAZ: her calistirmada sorulur, cunku her sunucuda
# farkli olan tek deger odur. install.sh once bu ayarlarin ozetini gosterir,
# onay ister; yanlis bir sey gorursen iptal et, burayi duzelt, yeniden calistir.

# ---- Kurulacaklar (1 = yap, 0 = atla) ----
POSTGRES=1               # PostgreSQL - Virtualmin kurulumuyla gelmiyor
COMPOSER=1               # Composer - vmkit-composer eklentisinin gereksinimi
DOCKER=1                 # Docker + Portainer + docker.<domain> proxy sitesi (tek bayrak)

# ---- Eklentiler (1 = kur, 0 = kurma) ----
# install.sh bunlari .wbm.gz olarak paketleyip Webmin'in kendi yoluyla kurar.
# 0 yapmak KURULU OLANI SOKMEZ, yalnizca kurmaz. Kaldirmak icin:
#   sudo ./update-plugins.sh --remove
PLUGIN_DEPLOY=1          # uzak git reposundan deploy
PLUGIN_COMPOSER=1        # composer install/update (klasor basina kendi PHP'siyle)
PLUGIN_CLOUDFLARE=1      # yerel zone -> Cloudflare senkronu

# ---- Ad onekleri (hepsi <onek>.<ana-domain> olur) ----
HOST_PREFIX=s            # panel/hostname   -> s.ornek.com
NS1_PREFIX=ns1           # zone'un NS cifti -> ns1.ornek.com
NS2_PREFIX=ns2           #                  -> ns2.ornek.com
DOCKER_PREFIX=docker     # Portainer sitesi -> docker.ornek.com

# ---- Yeni domainler icin varsayilanlar ----
# Virtualmin her domaine admin.<domain> A kaydi ve o adi panele (:10000)
# goturen bir yonlendirme ekliyor. 1 = kapat, 0 = dokunma.
# Yalnizca BUNDAN SONRA olusan domainleri etkiler.
NO_ADMIN_REDIRECT=1

# ---- Portainer ----
PORTAINER_IMAGE=portainer/portainer-ce:latest
PORTAINER_PORT=9000
PORTAINER_BIND_LOCAL=yes # yes = sadece 127.0.0.1 (erisim reverse-proxy uzerinden)

# ---- Kacis kapilari (gerekmedikce dokunmayin) ----
#DNS_RESOLVER=1.1.1.1    # DNS kontrolunde kullanilan dis resolver
#SERVER_IP=              # bos = otomatik tespit
#SKIP_DNS_CHECK=1        # A kaydi kontrolunu atla (tavsiye edilmez)
#ALLOW_ANY_OS=1          # Debian 12 disinda da calistir
