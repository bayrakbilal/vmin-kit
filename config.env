# vmin-kit - default settings.
#
# This file lives IN THE REPOSITORY and is where preferences belong: change it,
# commit it, and the next server that clones the repository installs the same
# way. Nothing to remember.
#
# THE MAIN DOMAIN IS NOT KEPT HERE: it is asked for on every run, because it is
# the one value that differs per server. install.sh shows a summary of these
# settings first and asks for confirmation; if something looks wrong, cancel,
# fix this file and run again.

# ---- What to install (1 = do it, 0 = skip) ----
POSTGRES=1               # PostgreSQL - not part of the Virtualmin install
COMPOSER=1               # Composer - required by the vmkit-composer plugin
DOCKER=1                 # Docker + Portainer + the docker.<domain> proxy site

# ---- Plugins (1 = install, 0 = do not) ----
# install.sh packages these as .wbm.gz and installs them Webmin's own way.
# Setting one to 0 does NOT remove an installed plugin, it only skips it. To
# remove one:
#   sudo ./update-plugins.sh --remove
PLUGIN_DEPLOY=1          # deploy from a remote git repository
PLUGIN_COMPOSER=1        # composer install/update (per directory, with its own PHP)
PLUGIN_CLOUDFLARE=1      # local zone -> Cloudflare sync

# ---- Management interfaces ----
# Publish Webmin and Usermin without opening a port: each becomes a sub-server
# under the main domain and is served through Apache with its own certificate.
# The same pattern as docker.<domain>.
PANEL_PROXY=1            # the webmin.<domain> and usermin.<domain> sub-servers
LOCK_PANEL_PORTS=1       # 10000/20000 listen on 127.0.0.1 only
ROUNDCUBE=1              # the webmail.<domain> sub-server + Roundcube
# Locking happens only if the proxy is VERIFIED to answer; if it cannot be
# verified the port stays open and the manual steps are printed. Losing access
# to the panel is not an acceptable outcome.

# ---- Role addresses to keep on new domains ----
# Virtualmin creates postmaster, abuse, hostmaster and webmaster on every
# domain. postmaster must be accepted under RFC 5321, and abuse is where
# operators and blocklist services send reports. The others are convention
# only. Anything not in this list is removed from the template (existing
# domains are unaffected).
ROLE_ALIASES="postmaster abuse"

# ---- Name prefixes (each becomes <prefix>.<main-domain>) ----
HOST_PREFIX=s            # panel/hostname     -> s.example.com
NS1_PREFIX=ns1           # the zone's NS pair -> ns1.example.com
NS2_PREFIX=ns2           #                    -> ns2.example.com
DOCKER_PREFIX=docker     # Portainer site     -> docker.example.com
WEBMIN_PREFIX=webmin     # Webmin             -> webmin.example.com
USERMIN_PREFIX=usermin   # Usermin            -> usermin.example.com
WEBMAIL_PREFIX=webmail   # Roundcube          -> webmail.example.com

# ---- Defaults for new domains ----
# Virtualmin adds two shortcuts to every domain: admin.<domain> to the panel
# (:10000) and webmail.<domain> to Usermin (:20000). Each is an A record plus a
# redirect. 1 = turn off, 0 = leave alone. Affects domains created FROM NOW ON
# only.
NO_ADMIN_REDIRECT=1
NO_WEBMAIL_REDIRECT=1


# ---- Portainer ----
# The 'lts' tag is the long-term support release line, used instead of 'latest'
# because the setup depends on two Portainer details - the 'setup_token=' line
# in its logs and the /api/users/admin/check call. A major release changing
# either would break the install silently.
PORTAINER_IMAGE=portainer/portainer-ce:lts
PORTAINER_PORT=9000
PORTAINER_BIND_LOCAL=yes # yes = 127.0.0.1 only (reached through the reverse proxy)

# ---- Escape hatches (leave alone unless you need them) ----
#DNS_RESOLVER=1.1.1.1    # external resolver used for the DNS check
#SERVER_IP=              # empty = detect automatically
#SKIP_DNS_CHECK=1        # skip the A record check (not recommended)
#ALLOW_ANY_OS=1          # run on something other than Debian 12/13 or Ubuntu 22.04/24.04
