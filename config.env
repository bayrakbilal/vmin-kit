# vmin-kit - varsayilan ayarlar.
#
# Bu dosya DEPODA durur ve tercihlerin yeridir: degistir, commit'le; sonraki
# sunucu depoyu cektiginde ayni sekilde kurulur. Hatirlamak zorunda kalma.
#
# ANA DOMAIN BURADA TUTULMAZ: her calistirmada sorulur, cunku her sunucuda
# farkli olan tek deger odur. install.sh once bu ayarlarin ozetini gosterir,
# onay ister; yanlis bir sey gorursen iptal et, burayi duzelt, yeniden calistir.

# ---- Kurulacaklar (1 = yap, 0 = atla) ----
POSTGRES=1               # PostgreSQL - Virtualmin kurulumuyla gelmiyor
COMPOSER=1               # Composer - vmkit-composer eklentisinin gereksinimi
DOCKER=1                 # Docker + Portainer + docker.<domain> proxy sitesi (tek bayrak)

# ---- Eklentiler (1 = kur, 0 = kurma) ----
# install.sh bunlari .wbm.gz olarak paketleyip Webmin'in kendi yoluyla kurar.
# 0 yapmak KURULU OLANI SOKMEZ, yalnizca kurmaz. Kaldirmak icin:
#   sudo ./update-plugins.sh --remove
PLUGIN_DEPLOY=1          # uzak git reposundan deploy
PLUGIN_COMPOSER=1        # composer install/update (klasor basina kendi PHP'siyle)
PLUGIN_CLOUDFLARE=1      # yerel zone -> Cloudflare senkronu

# ---- Yonetim arayuzleri ----
# Webmin ve Usermin'i disariya port acmadan yayinla: her biri ana domain
# altinda bir alt alan olur ve Apache uzerinden, kendi sertifikasiyla cikar.
# docker.<domain> ile ayni kalip.
PANEL_PROXY=1            # webmin.<domain> ve usermin.<domain> alt sunuculari
LOCK_PANEL_PORTS=1       # 10000/20000 yalnizca 127.0.0.1'de dinlesin
ROUNDCUBE=1              # webmail.<domain> alt sunucusu + Roundcube (webmail)
# Kilitleme yalnizca vekilin cevap verdigi DOGRULANIRSA yapilir; dogrulanamazsa
# port acik birakilir ve nasil elle yapilacagi yazilir. Panele erisimi
# kaybetmek istemiyoruz.

# ---- Yeni domainlerde birakilacak rol adresleri ----
# Virtualmin her domaine postmaster, abuse, hostmaster ve webmaster adreslerini
# aciyor. postmaster RFC 5321 geregi kabul edilmeli; abuse ise operatorlerin ve
# kara liste servislerinin bildirim adresi. Digerleri yalnizca gelenek.
# Buradaki listede olmayanlar sablondan cikarilir (var olan domainler etkilenmez).
ROLE_ALIASES="postmaster abuse"

# ---- Ad onekleri (hepsi <onek>.<ana-domain> olur) ----
HOST_PREFIX=s            # panel/hostname   -> s.ornek.com
NS1_PREFIX=ns1           # zone'un NS cifti -> ns1.ornek.com
NS2_PREFIX=ns2           #                  -> ns2.ornek.com
DOCKER_PREFIX=docker     # Portainer sitesi -> docker.ornek.com
WEBMIN_PREFIX=webmin     # Webmin           -> webmin.ornek.com
USERMIN_PREFIX=usermin   # Usermin          -> usermin.ornek.com
WEBMAIL_PREFIX=webmail   # Roundcube        -> webmail.ornek.com

# ---- Yeni domainler icin varsayilanlar ----
# Virtualmin her domaine iki kisayol ekliyor: admin.<domain> panele (:10000),
# webmail.<domain> Usermin'e (:20000). Her biri bir A kaydi + yonlendirme.
# 1 = kapat, 0 = dokunma. Yalnizca BUNDAN SONRA olusan domainleri etkiler.
NO_ADMIN_REDIRECT=1
NO_WEBMAIL_REDIRECT=1


# ---- Portainer ----
# 'lts' etiketi: uzun donem destekli surum dizisi. 'latest' yerine bunu
# kullaniyoruz cunku kurulum Portainer'in iki ayrintisina bagli - loglardaki
# 'setup_token=' satiri ve /api/users/admin/check dogrulamasi. Bir major
# surumun bunlari degistirmesi kurulumu sessizce bozardi.
PORTAINER_IMAGE=portainer/portainer-ce:lts
PORTAINER_PORT=9000
PORTAINER_BIND_LOCAL=yes # yes = sadece 127.0.0.1 (erisim reverse-proxy uzerinden)

# ---- Kacis kapilari (gerekmedikce dokunmayin) ----
#DNS_RESOLVER=1.1.1.1    # DNS kontrolunde kullanilan dis resolver
#SERVER_IP=              # bos = otomatik tespit
#SKIP_DNS_CHECK=1        # A kaydi kontrolunu atla (tavsiye edilmez)
#ALLOW_ANY_OS=1          # Debian 12 disinda da calistir
