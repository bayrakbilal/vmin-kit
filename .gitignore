# Not: config.env artık depoda izleniyor — varsayılan ayarlar orada durur,
# ana domain orada tutulmaz. Sunucuya özel bir değer gerekirse ortam
# değişkeni olarak verilir (ör. SERVER_IP=... ./install.sh).
*.log

# kurulum ciktisi
vmin-kit-rapor.txt

# yerel çalışma dosyaları (ekran görüntüleri vb.)
*.png
*.jpg

# build-plugins.sh çıktısı: paketler kaynaktan üretilir, depoda tutulmaz
dist/

# Inceleme icin gecici olarak kopyalanan ucuncu parti dosyalar
# (ornek: temanin bundle.js kaynagi) - depoya girmesinler.
bundle*.js
*.min.js
